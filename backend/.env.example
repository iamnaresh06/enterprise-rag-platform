# ==============================================================================
# Multi-Tenant Enterprise Agentic RAG Platform - Environment Configuration
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Relational Database (MySQL)
DB_NAME=enterprise_rag_db
DB_USER=rag_admin
DB_PASSWORD=rag_secure_password_2026
DB_HOST=127.0.0.1
DB_PORT=3306

# Asynchronous Broker & Caching (Redis)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Object Storage (AWS S3)
AWS_ACCESS_KEY_ID=mock_or_actual_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_or_actual_aws_secret_key
AWS_STORAGE_BUCKET_NAME=enterprise-rag-tenants-documents
AWS_S3_REGION_NAME=us-east-1

# Vector Database (Pinecone)
PINECONE_API_KEY=mock_or_actual_pinecone_api_key
PINECONE_INDEX_NAME=enterprise-rag-index
PINECONE_ENVIRONMENT=us-east-1

# AI & Embedding Model Configuration
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Large Language Model Provider (OpenAI / Anthropic / Local)
OPENAI_API_KEY=mock_or_actual_openai_api_key
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
